{
  "name": "agentpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multi-agent monitoring dashboard for Claude Code",
  "packageManager": "pnpm@10.34.1",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:dashboard\"",
    "dev:server": "pnpm --filter @agentpulse/server run dev",
    "dev:dashboard": "pnpm --filter @agentpulse/dashboard run dev",
    "build": "pnpm -r run build",
    "build:hook": "pnpm --filter @agentpulse/hook run build",
    "install:hook": "pnpm --filter @agentpulse/hook run install-hook",
    "test": "pnpm -r run test:unit",
    "test:unit": "pnpm -r run test:unit",
    "test:integration": "pnpm --filter @agentpulse/server run test:integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "pnpm -r run test:coverage"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.48.0"
  }
}
