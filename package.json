{
  "name": "agentpulse",
  "version": "0.1.0",
  "private": true,
  "description": "Real-time multi-agent monitoring dashboard for Claude Code",
  "workspaces": [
    "packages/shared",
    "packages/hook",
    "packages/server",
    "packages/dashboard"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:dashboard\"",
    "dev:server": "npm run dev --workspace=packages/server",
    "dev:dashboard": "npm run dev --workspace=packages/dashboard",
    "build": "npm run build --workspaces",
    "build:hook": "npm run build --workspace=packages/hook",
    "test": "npm run test --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:integration": "npm run test:integration --workspaces --if-present",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.7.0",
    "@playwright/test": "^1.48.0"
  }
}
